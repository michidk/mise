{
  "name": "mise",
  "version": "0.1.0",
  "description": "A tiny, open-source, peer-to-peer screen sharing service.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michidk/mise.git"
  },
  "bugs": {
    "url": "https://github.com/michidk/mise/issues"
  },
  "homepage": "https://miseshare.vercel.app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run build:client && npm run typecheck",
    "build:client": "tsc --project tsconfig.client.json",
    "dev": "npm run build:client && node --watch server.ts",
    "start": "npm run build:client && node server.ts",
    "pretest": "npm run build",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "vercel-build": "npm run build"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "express": "^5.1.0",
    "peer": "^1.0.2",
    "peerjs": "^1.5.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.13",
    "typescript": "^6.0.2"
  }
}
