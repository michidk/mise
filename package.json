{
  "name": "mise",
  "version": "0.1.0",
  "description": "A tiny, open-source, peer-to-peer screen sharing service.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michidk/mise.git"
  },
  "bugs": {
    "url": "https://github.com/michidk/mise/issues"
  },
  "homepage": "https://miseshare.vercel.app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run build:client && npm run typecheck",
    "build:client": "tsc --project tsconfig.client.json --noEmit && esbuild src/app.ts --bundle --format=esm --target=es2024 --outfile=public/app.js",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "dev": "npm run build:client && node --import tsx --watch server.ts",
    "start": "npm run build:client && node --import tsx server.ts",
    "pretest": "npm run build",
    "test": "node --import tsx --test",
    "test:unit": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm test",
    "vercel-build": "npm run build"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.13",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.9",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2"
  }
}
